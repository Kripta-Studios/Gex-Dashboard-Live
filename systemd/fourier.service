[Unit]
Description=Fourier Analysis Service Daemon
After=network.target

[Service]
# Usuario que ejecutará el script (cámbialo si no usas root)
User=root
Group=root

# Directorio donde está el script (IMPORTANTE para que encuentre la carpeta json_data)
WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot

# ACTUALIZADO para nueva estructura
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/services/fourier_service.py

# --- REINICIO AUTOMÁTICO ---
# Si el proceso muere por cualquier razón, reiniciarlo
Restart=always
# Esperar 5 segundos antes de reiniciar para no saturar si hay un error bucle
RestartSec=5
MemoryMax=1G
MemorySwapMax=0
Restart=always
# Opcional: Para ver los print() en los logs inmediatamente
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

