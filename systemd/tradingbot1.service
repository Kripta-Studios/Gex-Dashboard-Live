[Unit]
Description=Greek Exposure Trading Bot 1 - Live Trading
Documentation=https://github.com/kripta-studios/gex-trading
After=network.target

[Service]
Type=simple
User=root

# ACTUALIZADO para nueva estructura
WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot/bots
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/bots/tradingbot1.py

Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
