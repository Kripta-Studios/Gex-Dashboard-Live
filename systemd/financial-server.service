[Unit]
Description=Servidor de Datos Financieros (Puerto 8609)
After=network-online.target king-node.service
Wants=network-online.target king-node.service

[Service]
MemoryMax=1G
# Usuario que ejecutará el script (root o tu usuario normal)
User=root
# Directorio de trabajo (IMPORTANTE: para que encuentre la carpeta json_data)
WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot

# ACTUALIZADO para nueva estructura
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/services/servidor.py

# Reiniciar siempre si se cae
Restart=always
RestartSec=5

# Opcional: Para que los logs de Python se vean inmediatamente en journalctl
Environment=PYTHONUNBUFFERED=1
Environment=KING_NODE_SNAPSHOT=/var/lib/king-node/latest.json
Environment=KING_NODE_WEB_MAX_AGE_SECONDS=900
EnvironmentFile=-/etc/kripta/king-node.env

[Install]
WantedBy=multi-user.target

