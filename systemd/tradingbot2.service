[Unit]
Description=Greek Exposure Trading Bot 2 - Live Trading (Simplified Strategy)
Documentation=https://github.com/kripta-studios/gex-trading
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/tradingbot2.py
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=1G
CPUQuota=50%

[Install]
WantedBy=multi-user.target
