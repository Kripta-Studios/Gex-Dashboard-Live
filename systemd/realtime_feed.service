[Unit]
Description=GEX Realtime Feed Daemon - Live Base+JEPA Features
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root

WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot

ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/services/realtime_feed.py --interval 60 --jepa-model-dir /home/Option-Greeks-Plotting-Discord-Bot/neural/models/jepa/xinput_v3_production --jepa-device auto

Restart=always
RestartSec=5
MemoryMax=2G
MemorySwapMax=0
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

