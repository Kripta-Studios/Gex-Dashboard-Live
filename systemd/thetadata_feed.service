[Unit]
Description=Gex Realtime Feed Daemon
After=network.target

[Service]
# Usuario que ejecutará el script (cámbialo si no usas root)
User=root
Group=root

# Directorio donde está el script (IMPORTANTE para que encuentre la carpeta json_data)
WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot

# Comando exacto para ejecutar - ACTUALIZADO para nueva estructura
ExecStart=/usr/bin/java -Xms512M -Xmx2G -jar /home/Option-Greeks-Plotting-Discord-Bot/services/ThetaTerminalv3.jar

# --- REINICIO AUTOMÁTICO ---
# Si el proceso muere por cualquier razón, reiniciarlo
Restart=always
# Esperar 5 segundos antes de reiniciar para no saturar si hay un error bucle
RestartSec=5
MemoryMax=2.5G
MemorySwapMax=0
Restart=always
# Opcional: Para ver los print() en los logs inmediatamente
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

