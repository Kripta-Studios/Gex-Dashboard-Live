[Unit]
Description=GEX Level-Stability Structural Options Live Trading Bot
Documentation=https://github.com/kripta-studios/gex-trading
After=network-online.target realtime_feed.service
Wants=network-online.target realtime_feed.service

[Service]
Type=simple
User=root

WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/bots/tradingbot_wrapper_jepa.py --disable-level-signal --disable-structural-profile --disable-option-value --event-option-policy-path /home/Option-Greeks-Plotting-Discord-Bot/neural/models/jepa/jepa_production_event_options_frozen2025_static_union_202607/event_option_policy.json --require-event-option-policy --event-option-component-registry-path /home/Option-Greeks-Plotting-Discord-Bot/neural/models/jepa/jepa_production_event_options_frozen2025_static_union_202607/component_registry.json --require-event-option-component-registry --require-event-option-live-ready --enable-event-option-scorer --strict-event-option-features --paper-order-intents --rt-data-dir /home/Option-Greeks-Plotting-Discord-Bot/rt_data --trades-dir /home/Option-Greeks-Plotting-Discord-Bot/trades_jepa --tickers SPX QQQ SPY

Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=2G
CPUQuota=75%

[Install]
WantedBy=multi-user.target
