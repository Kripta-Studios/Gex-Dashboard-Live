[Unit]
Description=GEX JEPA Live Trading Bot - GBT+JEPA 180m + Fixed 0.70 Delta
Documentation=https://github.com/kripta-studios/gex-trading
After=network-online.target realtime_feed.service
Wants=network-online.target realtime_feed.service

[Service]
Type=simple
User=root

WorkingDirectory=/home/Option-Greeks-Plotting-Discord-Bot
ExecStart=/usr/bin/python3 /home/Option-Greeks-Plotting-Discord-Bot/bots/tradingbot_wrapper_jepa.py --model-dir /home/Option-Greeks-Plotting-Discord-Bot/neural/models/jepa/jepa_production_final_180m --rt-data-dir /home/Option-Greeks-Plotting-Discord-Bot/rt_data --trades-dir /home/Option-Greeks-Plotting-Discord-Bot/trades_jepa --tickers SPX QQQ SPY

Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

# Resource limits
MemoryMax=2G
CPUQuota=75%

[Install]
WantedBy=multi-user.target
