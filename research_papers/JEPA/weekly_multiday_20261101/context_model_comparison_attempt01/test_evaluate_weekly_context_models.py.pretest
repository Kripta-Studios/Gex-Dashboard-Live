from __future__ import annotations

from datetime import datetime
import importlib.util
from pathlib import Path

import numpy as np
import pytest


HERE = Path(__file__).resolve().parent
SPEC = importlib.util.spec_from_file_location("context_models", HERE / "evaluate_weekly_context_models.py")
assert SPEC and SPEC.loader
comparison = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(comparison)
EVALUATOR = comparison.import_pinned(comparison.EVALUATOR, comparison.EVALUATOR_SHA256, "test_evaluator_pure")


def candidate(candidate_id: str, ticker: str, right: str, weekday: int, date: str = "20260102") -> dict:
    features = {name: float(index + 1) for index, name in enumerate(comparison.FEATURE18)}
    features["weekday"] = weekday
    return {
        "candidate_id": candidate_id, "ticker": ticker, "right": right,
        "entry_date": date, "features": features, "scenario": 1,
        "decision_ask": 1.0, "net_base": 1.0, "net_adverse": 0.0,
        "payoff_is_lower_bound": False, "_available": datetime.fromisoformat("2026-01-05T10:35:00-05:00"),
    }


def context(ticker: str, date: str, *, status: str = "CONTEXT_AVAILABLE", valid: bool | None = True) -> dict:
    return {
        "ticker": ticker, "date": date, "status": status, "state_valid": valid,
        "context_81": None if status == "CONTEXT_MISSING_SOURCE" else [float(index + 1) for index in range(81)],
    }


def test_category30_order_is_exact_one_hot() -> None:
    row = candidate("x", "QQQ", "PUT", 3)
    values = comparison.category30(row)
    assert len(values) == 30 and sum(values) == 1
    assert values[(1 * 2 + 1) * 5 + 3] == 1
    assert comparison.category_names()[0] == "SPY:CALL:weekday0"
    assert comparison.category_names()[-1] == "SPXW:PUT:weekday4"


def test_context182_masks_invalid_and_missing_and_signs_put() -> None:
    call = candidate("c", "SPY", "CALL", 0)
    put = candidate("p", "SPY", "PUT", 0)
    valid_call = comparison.context182(call, context("SPY", call["entry_date"]))
    valid_put = comparison.context182(put, context("SPY", put["entry_date"]))
    assert len(valid_call) == 182 and valid_call[18:99] == valid_put[18:99]
    assert valid_call[99:180] == [-value for value in valid_put[99:180]]
    invalid = comparison.context182(call, context("SPY", call["entry_date"], valid=False))
    missing = comparison.context182(call, context("SPY", call["entry_date"], status="CONTEXT_MISSING_SOURCE", valid=None))
    assert invalid[18:180] == [0.0] * 162 and invalid[-2:] == [1.0, 0.0]
    assert missing[18:180] == [0.0] * 162 and missing[-2:] == [0.0, 0.0]
    poisoned = context("SPY", call["entry_date"])
    poisoned.update({"tokens": [999.0], "maps": [999.0], "oracle_label": 4, "future_value": 999.0})
    assert comparison.context182(call, poisoned) == valid_call


def test_join_is_many_to_one_complete_and_rejects_duplicate_or_missing() -> None:
    rows = [candidate("c", "SPY", "CALL", 0), candidate("p", "SPY", "PUT", 0)]
    contexts = [context("SPY", "20260102")]
    coverage = {"rows": [{"ticker": "SPY", "date": "20260102"}]}
    comparison.join_context(rows, contexts, coverage, [f"f{i}" for i in range(81)])
    assert len(rows[0]["_x_context"]) == 182 and rows[0]["_x_context"][18:99] == rows[1]["_x_context"][18:99]
    with pytest.raises(comparison.ComparisonError, match="duplicate"):
        comparison.join_context(rows, contexts * 2, coverage, [f"f{i}" for i in range(81)])
    with pytest.raises(comparison.ComparisonError, match="lacks context"):
        comparison.join_context([candidate("q", "QQQ", "CALL", 0)], contexts, coverage, [f"f{i}" for i in range(81)])


def test_split_cutoffs_and_label_availability_purge_are_unchanged() -> None:
    train_ok = candidate("train_ok", "SPY", "CALL", 0, "20241231")
    train_ok["_available"] = datetime.fromisoformat("2024-12-31T10:35:00-05:00")
    train_purged = candidate("train_bad", "SPY", "PUT", 0, "20241231")
    train_purged["_available"] = datetime.fromisoformat("2025-01-02T10:35:00-05:00")
    cal = candidate("cal", "QQQ", "CALL", 1, "20251231")
    cal["_available"] = datetime.fromisoformat("2025-12-31T10:35:00-05:00")
    evaluated = candidate("eval", "SPXW", "CALL", 2, "20260102")
    splits = comparison.eligible_splits(EVALUATOR, [train_ok, train_purged, cal, evaluated], strict=False)
    assert [row["candidate_id"] for row in splits["TRAIN"] if row["_model_label_eligible"]] == ["train_ok"]
    assert all(row["_model_label_eligible"] for row in [cal, evaluated])


def test_generic_transformer_keeps_all_missing_columns_and_order() -> None:
    values = np.asarray([[1.0, np.nan], [2.0, np.nan], [3.0, np.nan]])
    transformer = comparison.GenericTrainTransformer(["observed", "empty"]).fit(values)
    transformed = transformer.transform(values)
    artifact = transformer.as_dict()
    assert transformed.shape[0] == 3
    assert artifact["feature_order"] == ["observed", "empty"]
    assert artifact["medians"][1] == 0
    assert artifact["fit_scope"] == "TRAIN_ONLY"


def synthetic_fit_rows() -> list[dict]:
    rows = []
    dates = (("TRAIN", "20240102"), ("CAL", "20250102"), ("EVAL", "20260102"))
    for split, date in dates:
        for index in range(10):
            row = candidate(f"{split}:{index}", comparison.TICKERS[index % 3], comparison.RIGHTS[index % 2], index % 5, date)
            row["scenario"] = index % 5
            row["_split"], row["_model_label_eligible"] = split, True
            row["_x_category"] = comparison.category30(row)
            row["_x_context"] = comparison.context182(row, context(row["ticker"], date))
            rows.append(row)
    return rows


def synthetic_means() -> dict:
    cells = {}
    for cost in ("base", "adverse"):
        cells[cost] = {
            f"{ticker}:{right}": {str(label): {"n": 1, "mean_y": float(label - 2)} for label in range(5)}
            for ticker in comparison.TICKERS for right in comparison.RIGHTS
        }
    return {"cells": cells}


def test_exactly_two_new_fits_and_base_is_not_refit() -> None:
    rows = synthetic_fit_rows()
    artifacts = comparison.fit_two_models(EVALUATOR, rows, [f"f{i}" for i in range(81)], np.full(5, 0.2), synthetic_means())
    assert list(artifacts) == ["CATEGORY30", "CONTEXT182"]
    assert all(artifact["model"]["fit_scope"] == "TRAIN_ONLY" for artifact in artifacts.values())
    assert all("_p_BASE18_FROZEN" not in row for row in rows)
    assert all("_p_CONTEXT182" not in row for row in rows)
    for model in comparison.NEW_MODELS:
        comparison.score_fitted(EVALUATOR, rows, model, artifacts[model])
    assert all("_p_CONTEXT182" in row and "_p_CATEGORY30" in row for row in rows)


def test_bootstrap_is_date_paired_deterministic_and_keeps_empty_sessions() -> None:
    sessions = ["20260102", "20260105", "20260106", "20260107", "20260108", "20260109"]
    rows = []
    for index, day in enumerate(sessions[:-1]):
        row = candidate(str(index), "SPY", "CALL", index % 5, day)
        row["_p_BASE18_FROZEN"] = [0.1, 0.5, 0.1, 0.2, 0.1]
        row["_p_CONTEXT182"] = [0.1, 0.6, 0.1, 0.1, 0.1]
        rows.append(row)
    first = comparison.paired_bootstrap(rows, sessions, resamples=100, seed=20261101)
    second = comparison.paired_bootstrap(rows, sessions, resamples=100, seed=20261101)
    assert first == second and first["paired_daily_contributions"][-1]["candidate_count"] == 0
    assert first["estimate"] > 0


def test_risk_baseline_comparison_is_exact_and_sensitive() -> None:
    expected = {"base": [{"event": "ENTRY", "quantity": 2}], "adverse": [{"event": "ENTRY", "quantity": 2}]}
    comparison.exact_baseline({key: [dict(row) for row in values] for key, values in expected.items()}, expected)
    changed = {"base": [{"event": "ENTRY", "quantity": 3}], "adverse": expected["adverse"]}
    with pytest.raises(comparison.ComparisonError, match="BASE18"):
        comparison.exact_baseline(changed, expected)


def test_source_has_no_global_mutation_or_automatic_real_execution() -> None:
    source = (HERE / "evaluate_weekly_context_models.py").read_text(encoding="utf-8")
    assert "evaluator.FEATURES =" not in source
    assert "replay.STARTING_CASH =" not in source
    assert "--execute-reviewed-comparison" in source
