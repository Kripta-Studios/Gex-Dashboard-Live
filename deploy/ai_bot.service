[Unit]
Description=GEX One - AI Trading Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Gex-Dashboard-Live
ExecStart=/usr/bin/python3 bots/tradingbot_wrapper.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/Gex-Dashboard-Live/logs/gex_bot.log
StandardError=append:/home/ubuntu/Gex-Dashboard-Live/logs/gex_bot.error.log
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
