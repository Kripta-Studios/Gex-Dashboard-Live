# KING NODE v2 runtime configuration for systemd EnvironmentFile.
# This file intentionally contains no credentials or source paths.

# Separate atomic artifacts: failed refreshes never overwrite a valid surface.
KING_NODE_CURRENT_ATTEMPT=/var/lib/king-node/current-attempt.json
KING_NODE_OUTPUT=/var/lib/king-node/latest.json
KING_NODE_LIVE_SNAPSHOT=/var/lib/king-node/latest.json
KING_NODE_LAST_COMPLETED_SNAPSHOT=/var/lib/king-node/last-completed.json
KING_NODE_HEALTH_STATE=/var/lib/king-node/health.json
KING_NODE_STATE_FILE=/var/lib/king-node/state.json
KING_NODE_REFERENCE=/home/Option-Greeks-Plotting-Discord-Bot/config/king_node_reference.json
KING_NODE_INTERVAL_SECONDS=30
KING_NODE_LOG_LEVEL=INFO
KING_NODE_LIVE_MAX_AGE_SECONDS=180

# Shared with services/servidor.py.
KING_NODE_SNAPSHOT=/var/lib/king-node/latest.json
KING_NODE_WEB_MAX_AGE_SECONDS=180
KING_NODE_FRONTEND_SCHEMA=king-node.v2
FINANCIAL_SERVER_BIND=127.0.0.1

# Local Theta Terminal v3. No ThetaData credential is stored here.
THETADATA_URL=http://127.0.0.1:25503/v3

# Options STANDARD volatility reconstruction.
KING_NODE_THETA_OPTION_MAX_AGE_SECONDS=180
KING_NODE_THETA_EXPIRATION_CACHE_SECONDS=21600
KING_NODE_THETA_MIN_UNDERLYING_OBSERVATIONS=3
KING_NODE_THETA_MAX_UNDERLYING_DISPERSION_PCT=0.10
KING_NODE_THETA_MIN_VALID_STRIKES_PER_TERM=8
KING_NODE_RATE_SYMBOL=SOFR
KING_NODE_RATE_LOOKBACK_DAYS=10

# The observed deployed capability is Options STANDARD / Index FREE.  A strict
# live v2 snapshot fails closed if a required direct index or Pro-only Greek is
# unavailable; values are never guessed or marked observed by proxy.
KING_NODE_OPTIONS_TIER=STANDARD
KING_NODE_INDEX_TIER=FREE
